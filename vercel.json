{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/auth/:match*", "destination": "/api/auth.js" },
    { "source": "/api/admin/:match*", "destination": "/api/admin.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" }
  ]
}
