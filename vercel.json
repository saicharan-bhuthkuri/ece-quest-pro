{
  "version": 2,
  "name": "ece-quest-pro",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/auth.js"
    },
    {
      "src": "/app",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/landing.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/landing.html"
    }
  ]
}
