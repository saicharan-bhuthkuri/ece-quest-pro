{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(app-debug\\.apk|download)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ECE-Quest-Pro.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/landing", "destination": "/", "permanent": true },
    { "source": "/landing.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/app-debug.apk" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/auth/:path*", "destination": "/api/auth.js" },
    { "source": "/auth", "destination": "/api/auth.js" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/admin/:path*", "destination": "/api/admin.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" }
  ]
}
